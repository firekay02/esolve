{
  "info": {
    "name": "FixItNow API",
    "description": "Complete API collection for FixItNow remote tech support platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"Password123\",\n  \"role\": \"customer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('token', response.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"Password123\",\n  \"newPassword\": \"NewPassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/change-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "change-password"]
            }
          }
        }
      ]
    },
    {
      "name": "Sessions",
      "item": [
        {
          "name": "Book Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"issue_type\": \"Computer running slow\",\n  \"issue_description\": \"My computer has been running very slowly for the past week. It takes forever to start up and applications are very sluggish.\",\n  \"scheduled_time\": \"2024-01-15T10:00:00Z\",\n  \"urgency\": \"medium\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sessions/book",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "book"]
            }
          }
        },
        {
          "name": "Get My Sessions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/sessions/my?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "my"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "status",
                  "value": "pending",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Get Session Details",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/sessions/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "1"]
            }
          }
        },
        {
          "name": "Update Session (Technician)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in_progress\",\n  \"remote_link\": \"https://teamviewer.com/session/123456\",\n  \"technician_notes\": \"Started remote session, investigating performance issues.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sessions/1/update",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "1", "update"]
            }
          }
        },
        {
          "name": "Cancel Session",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/sessions/1/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "1", "cancel"]
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get User Profile",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/users/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "profile"]
            }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Updated Doe\",\n  \"email\": \"john.updated@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "profile"]
            }
          }
        },
        {
          "name": "Get Technicians (Admin)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/users/technicians?available=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "technicians"],
              "query": [
                {
                  "key": "available",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "Get User Stats",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/users/1/stats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "1", "stats"]
            }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Create Payment Intent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_id\": 1,\n  \"amount\": 49.99,\n  \"currency\": \"usd\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/create-intent",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "create-intent"]
            }
          }
        },
        {
          "name": "Confirm Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_intent_id\": \"pi_1234567890\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "confirm"]
            }
          }
        },
        {
          "name": "Get Payment History",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/payments/history?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "history"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Request Refund",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Service was not satisfactory\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/1/refund",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "1", "refund"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Get Dashboard Stats",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "dashboard"]
            }
          }
        },
        {
          "name": "Get All Sessions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/sessions?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "sessions"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "status",
                  "value": "pending",
                  "disabled": true
                },
                {
                  "key": "technician_id",
                  "value": "1",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Assign Technician",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"technician_id\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/sessions/1/assign",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "sessions", "1", "assign"]
            }
          }
        },
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/users?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "role",
                  "value": "customer",
                  "disabled": true
                },
                {
                  "key": "active",
                  "value": "true",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "john",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Toggle User Status",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/1/toggle-status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users", "1", "toggle-status"]
            }
          }
        },
        {
          "name": "Get Revenue Analytics",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/revenue?period=monthly",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "revenue"],
              "query": [
                {
                  "key": "period",
                  "value": "monthly"
                },
                {
                  "key": "start_date",
                  "value": "2024-01-01",
                  "disabled": true
                },
                {
                  "key": "end_date",
                  "value": "2024-12-31",
                  "disabled": true
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Feedback",
      "item": [
        {
          "name": "Submit Feedback",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5,\n  \"feedback\": \"Excellent service! The technician was very professional and solved my problem quickly. Highly recommend!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/feedback/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "feedback", "1"]
            }
          }
        },
        {
          "name": "Get Technician Feedback",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/feedback/technician/2?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "feedback", "technician", "2"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get Session Feedback",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/feedback/session/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "feedback", "session", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    }
  ]
}